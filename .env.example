# Copy to .env. Never commit the real file.
MUSICBOT_DATABASE_PATH=data/events.db
MUSICBOT_DEFAULT_TIMEZONE=America/New_York
MUSICBOT_DISCOVERY_START_OFFSET_DAYS=1
MUSICBOT_DISCOVERY_HORIZON_DAYS=180
MUSICBOT_DEFAULT_EVENT_DURATION_MINUTES=180
MUSICBOT_MINIMUM_AFFINITY_SCORE=15
MUSICBOT_MINIMUM_MATCH_SCORE=0
MUSICBOT_DISCOVERY_CRON=17 3 * * *
MUSICBOT_REVIEW_SYNC_INTERVAL_MINUTES=15
# New review cards posted per sync cycle, highest score first (0 = no cap).
MUSICBOT_REVIEW_POST_BATCH_SIZE=25
# Approved events publish in paced batches, soonest show first, so the
# community is not blasted with pings (0 = publish immediately on approval).
MUSICBOT_PUBLISH_BATCH_PER_HOUR=10
# Announcements only go out between these local hours (24 = until midnight).
MUSICBOT_PUBLISH_START_HOUR=6
MUSICBOT_PUBLISH_END_HOUR=24

# Discord (required for bot/review publishing)
MUSICBOT_DISCORD_TOKEN=
MUSICBOT_DISCORD_GUILD_ID=
MUSICBOT_REVIEW_CHANNEL_ID=
MUSICBOT_ANNOUNCEMENT_CHANNEL_ID=
# Optional second channel for shows farther than MUSICBOT_LOCAL_RADIUS_MILES
# from home. They are posted there with no role ping, so members who only
# want shows they can drive to mute one channel instead of dropping genre
# roles. Leave blank to announce everything in one channel.
MUSICBOT_REGIONAL_ANNOUNCEMENT_CHANNEL_ID=
MUSICBOT_LOCAL_RADIUS_MILES=75
MUSICBOT_ADMIN_USER_IDS=
MUSICBOT_REVIEWER_ROLE_IDS=
# JSON object: normalized genre -> Discord role ID
MUSICBOT_GENRE_ROLE_MAP={"indie rock":"123456789012345678"}

# Taste profile (comma-separated)
MUSICBOT_PREFERRED_ARTISTS=
MUSICBOT_PREFERRED_GENRES=
MUSICBOT_PREFERRED_VENUES=
# Genres too broad to justify review on their own (weak scoring evidence).
# Defaults cover rock/pop/country/etc.; override to tune the review gate,
# or append deployment-specific demotions without repeating the defaults:
#MUSICBOT_UMBRELLA_GENRES=rock, pop, ...
#MUSICBOT_UMBRELLA_GENRES_EXTRA=indie folk, gospel, ...

# Ticketmaster Discovery API (optional)
# Set home to the centre of your own region; overlapping cells then cover the
# full travel radius below. The example is downtown Pittsburgh.
MUSICBOT_TICKETMASTER_API_KEY=
MUSICBOT_HOME_LATITUDE=40.4406
MUSICBOT_HOME_LONGITUDE=-79.9959
# Applied at ingest to every source. Note 350 admits New York (308 mi),
# Toronto (224) and Columbus (169); lower it to tighten the region.
MUSICBOT_MAX_TRAVEL_RADIUS_MILES=350
# Acts that never reach review, whatever else is on the bill. Hand-maintained
# JSON array of {"name", "reason"} -- see src/music_event_bot/domain/blocklist.py.
# The tracked file is an EXAMPLE. A real blocklist records your community's own
# moderation calls about named people, so keep it out of the repo: copy it to
# config/blocked-artists.local.json (gitignored) and point this at the copy.
MUSICBOT_BLOCKED_ARTISTS_PATH=config/blocked-artists.json
# The default produces 31 overlapping cells; too-small radii are rejected above 64 cells.
MUSICBOT_TICKETMASTER_CELL_RADIUS_MILES=90
MUSICBOT_TICKETMASTER_MAX_PAGES=2

# Legacy single-market settings (leave blank to use regional coverage above)
MUSICBOT_DISCOVERY_LATITUDE=
MUSICBOT_DISCOVERY_LONGITUDE=
MUSICBOT_DISCOVERY_RADIUS_MILES=75
MUSICBOT_TICKETMASTER_COUNTRY_CODE=US

# Feeds (comma-separated; optional). ICS entries may also be local file paths.
MUSICBOT_ICS_URLS=
MUSICBOT_RSS_URLS=
# Squarespace event collections (the /events page URL; ?format=json is added)
MUSICBOT_SQUARESPACE_URLS=
# Default location for single-venue feeds whose events omit venue/location.
# JSON: feed URL fragment -> "Venue Name, street, city, ST" (venue = text
# before the first comma).
#MUSICBOT_FEED_VENUE_DEFAULTS={"poetrymillvale.com": "Poetry Lounge, 313 North Avenue, Millvale, PA 15209"}

# Spotify taste import (optional)
# Register the redirect URI exactly in Spotify; localhost is not accepted.
# Run: music-event-bot spotify-auth --output-file .spotify_refresh_token
# Copy the secret token into this file, then delete the temporary token file.
# The token must carry the user-top-read and user-library-read scopes; re-run
# spotify-auth if it predates the Liked Songs import.
MUSICBOT_SPOTIFY_CLIENT_ID=
MUSICBOT_SPOTIFY_CLIENT_SECRET=
MUSICBOT_SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
MUSICBOT_SPOTIFY_REFRESH_TOKEN=
# An artist joins the taste profile when at least this many of their songs are Liked.
MUSICBOT_SPOTIFY_LIKED_ARTIST_MIN_TRACKS=12
# A full import walks the whole library, so imported artists are cached and
# reused for this many hours (merge-only; past favorites persist). 0 = import
# on every run. On any Spotify failure the cache is used instead.
MUSICBOT_SPOTIFY_REFRESH_HOURS=24

# Last.fm niche genre tags (optional; free key at https://www.last.fm/api/account/create)
# No Last.fm account history needed; tags are global community data per artist.
# Without a key, tags come from MusicBrainz instead (keyless, sparser tags).
MUSICBOT_LASTFM_API_KEY=
MUSICBOT_MUSICBRAINZ_ENABLED=true
MUSICBOT_LASTFM_MIN_TAG_WEIGHT=10
MUSICBOT_LASTFM_MAX_TAGS_PER_ARTIST=8
# Re-fetch an artist's tags after this many days and MERGE them into the
# stored set: new tags accumulate, existing tags are never removed, so an
# artist whose style evolves keeps old and new genres. 0 = fetch once, never
# refresh.
MUSICBOT_LASTFM_TAG_CACHE_DAYS=90

# Claude genre mapping (optional): maps niche tags onto the Discord genre
# buckets in MUSICBOT_GENRE_ROLE_MAP plus broad Ticketmaster-style genres.
# Results are cached in SQLite; only new tags are ever sent.
MUSICBOT_ANTHROPIC_API_KEY=
MUSICBOT_GENRE_MAP_MODEL=claude-sonnet-5
